# ===== Green Oak Virtual Plant Lab — ตัวอย่างการตั้งค่า =====
# คัดลอกเป็นไฟล์ .env แล้วแก้ค่าตามเครื่อง

# --- Server ---
# 127.0.0.1 = ใช้เฉพาะเครื่องนี้, 0.0.0.0 = เปิดให้เครื่องใน LAN เข้าได้ (ห้ามเปิดสู่ Internet)
SERVER_HOST=127.0.0.1
SERVER_PORT=3001

# --- Simulation ---
SIM_TICK_MS=100
WS_BROADCAST_MS=200
WS_HEARTBEAT_MS=1000
# จำนวน Lab (M1 ใช้ 1, M4 ใช้ 10)
LAB_COUNT=1

# --- Web ---
# โฟลเดอร์หน้าเว็บที่ build แล้ว (เว้นว่าง = apps/web/dist)
WEB_DIST=

# --- PLC ---
PLC_POLL_MS=500
PLC_COMMAND_TIMEOUT_MS=3000
# โหมดเริ่มต้นของ Mock PLC: manual | auto (Test เท่านั้น) | offline
MOCK_PLC_MODE=manual

# --- Game ---
# ปลดล็อกทุกด่าน (โหมดผู้พัฒนา) — เว้นว่าง = เปิดเมื่อ npm run dev, ปิดเมื่อ npm run serve/start (P47)
UNLOCK_ALL_LEVELS=

# --- บัญชีผู้เล่น (Milestone W) ---
# เว้นว่าง = ปิดระบบบัญชี (เล่นได้เลย); ตั้ง = ต้อง Login ก่อนเล่น
#   postgres://…  = Postgres จริง (Neon บน Cloud)
#   memory://     = PGlite ในหน่วยความจำ (หายเมื่อปิด Server — ใช้ทดสอบ)
#   ./data/accounts = PGlite เก็บในโฟลเดอร์ (ทดสอบในเครื่อง)
DATABASE_URL=
# กุญแจลงชื่อ Token (สุ่มยาว ๆ ห้ามเปิดเผย) — เว้นว่าง = สุ่มใหม่ทุกครั้งที่เริ่ม Server
AUTH_SECRET=
# 1 = รันหลัง Proxy ของ Cloud (Render) เพื่อจำกัดการลองผิดตาม IP จริง
TRUST_PROXY=

# --- เครื่องมือครู (npm run admin, W3) ---
# กุญแจของครู ยาวอย่างน้อย 16 ตัว — ตั้งค่าเดียวกันทั้งบน Server และเครื่องครู (ห้ามเปิดเผย)
ADMIN_KEY=
# Server ที่ npm run admin จะเรียก — เว้นว่าง = http://127.0.0.1:<SERVER_PORT> (เครื่องนี้)
GOL_API_URL=
