# ===== Green Oak Virtual Plant Lab — ตัวอย่างการตั้งค่า =====
# คัดลอกเป็นไฟล์ .env แล้วแก้ค่าตามเครื่อง

# --- Server ---
# 127.0.0.1 = ใช้เฉพาะเครื่องนี้, 0.0.0.0 = เปิดให้เครื่องใน LAN เข้าได้ (ห้ามเปิดสู่ Internet)
SERVER_HOST=127.0.0.1
SERVER_PORT=3001

# --- Simulation ---
SIM_TICK_MS=100
WS_BROADCAST_MS=200
WS_HEARTBEAT_MS=1000
# จำนวน Lab (M1 ใช้ 1, M4 ใช้ 10)
LAB_COUNT=1

# --- PLC ---
PLC_POLL_MS=500
PLC_COMMAND_TIMEOUT_MS=3000
# โหมดเริ่มต้นของ Mock PLC: auto | manual | offline
MOCK_PLC_MODE=auto
