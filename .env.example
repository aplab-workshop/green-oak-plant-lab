# ===== Green Oak Virtual Plant Lab — ตัวอย่างการตั้งค่า =====
# คัดลอกเป็นไฟล์ .env แล้วแก้ค่าตามเครื่อง

# --- Server ---
# 127.0.0.1 = ใช้เฉพาะเครื่องนี้, 0.0.0.0 = เปิดให้เครื่องใน LAN เข้าได้ (ห้ามเปิดสู่ Internet)
SERVER_HOST=127.0.0.1
SERVER_PORT=3001

# --- Simulation ---
SIM_DT_S=1
SIM_TICK_MS=100
WS_BROADCAST_MS=200

# --- PLC (ใช้ตั้งแต่ P4/M3) ---
PLC_POLL_MS=500
PLC_COMMAND_TIMEOUT_MS=3000
